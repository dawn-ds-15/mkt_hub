DATABASE_URL="postgresql://user:password@host:5432/postgres"
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="8h"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-pass
SMTP_FROM="MKT Hub" <your-email@gmail.com>

GOOGLE_MAIL_WEBHOOK_URL="https://script.google.com/macros/s/..."

# --- FILE STORAGE (Supabase Storage) ---
# When both are set, uploaded files (project documents, expense line attachments,
# inventory batch attachments) go to a PRIVATE bucket instead of the local uploads/ folder,
# so they survive redeploys. Supabase Dashboard > Project Settings > API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional, created automatically on first upload
SUPABASE_STORAGE_BUCKET="mkt-hub-files"

# --- AGENTROUTER AI CONFIGURATION ---
OPENAI_API_KEY="your-agentrouter-api-key"
OPENAI_BASE_URL="https://agentrouter.org/v1"
OPENAI_MODEL="gpt-5.6-sol"
OPENAI_BACKUP_MODEL="claude-opus-4-8"
OPENAI_AVAILABLE_MODELS="gpt-5.6-sol,claude-opus-4-8,claude-opus-5"

# --- LEAD INGESTION FROM EVENT SITE (tonghoplink) ---
LEAD_FROM_EVENT_SITE_ENABLED=true
LEAD_FROM_EVENT_SITE_RATE_LIMIT=60
